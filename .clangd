CompileFlags:
  # nvcc-specific flags from compile_commands.json that clang does not understand
  Remove:
    - -W*
    - -forward-unknown-to-host-compiler
    - --options-file
    - --generate-code=*
    - -Xcompiler=*
    - --expt-relaxed-constexpr
    - --expt-extended-lambda
    - -rdc=true
    - -rdc
    - --relocatable-device-code=*
  Add:
    # clang defaults to sm_35, which recent CUDA toolkits no longer support.
    # Skip the toolkit/arch version check so the same config works on every machine.
    - --no-cuda-version-check
    - -Wno-unknown-cuda-version

Diagnostics:
  UnusedIncludes: None

InlayHints:
  Enabled: true
  Designators: true
  ParameterNames: true
  DeducedTypes: true
  DefaultArguments: false
  TypeNameLimit: 24
  BlockEnd: false
